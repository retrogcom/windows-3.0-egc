@ECHO OFF
SET EGCCMP=CMPINI.COM
IF NOT "%1"=="" SET EGCCMP=%1
IF NOT EXIST %EGCCMP% GOTO NOCMP
IF NOT EXIST SYSTEM.INI GOTO WRONG
IF NOT EXIST WIN.INI GOTO WRONG
IF NOT EXIST WIN.COM GOTO WRONG
IF NOT EXIST SETUP.EXE GOTO WRONG
IF EXIST EGCBAK\COMPLETE.TAG GOTO EXISTS
IF EXIST EGCBAK\SYSTEM.INI GOTO EXISTS
IF EXIST EGCBAK\WIN.INI GOTO EXISTS
IF EXIST EGCBAK\WIN.COM GOTO EXISTS
IF EXIST EGCBAK\NUL GOTO EXISTS
MD EGCBAK
COPY /B SYSTEM.INI EGCBAK\SYSTEM.INI >NUL
%EGCCMP% SYSTEM.INI EGCBAK\SYSTEM.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B WIN.INI EGCBAK\WIN.INI >NUL
%EGCCMP% WIN.INI EGCBAK\WIN.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B WIN.COM EGCBAK\WIN.COM >NUL
%EGCCMP% WIN.COM EGCBAK\WIN.COM >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO Windows configuration saved before EGC Setup.>EGCBAK\COMPLETE.TAG
ECHO Backup complete in EGCBAK. You can now run SETUP.
GOTO END
:EXISTS
ECHO EGCBAK already exists. Its original backup has NOT been overwritten.
ECHO Check EGCBAK\COMPLETE.TAG and retain this backup when changing colours.
GOTO END
:WRONG
ECHO Exit Windows and change to its installation directory first.
ECHO Use the directory that contains your installed SYSTEM.INI.
ECHO Then run this BACKUP.BAT using its full path.
GOTO END
:FAILED
ECHO Backup did not complete. Do not install until the backup is verified.
GOTO END
:NOCMP
ECHO CMPINI.COM is required to verify the copied configuration.
ECHO Pass the full CMPINI.COM path as argument 1.
ECHO No files have been copied.
:END
SET EGCCMP=
