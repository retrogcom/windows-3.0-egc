@ECHO OFF
SET EGCCMP=C:\EGCTEST\WIN16\CMPINI.COM
IF NOT "%1"=="" SET EGCCMP=%1
IF NOT EXIST %EGCCMP% GOTO NOCMP
IF NOT EXIST SYSTEM.INI GOTO WRONG
IF NOT EXIST WIN.COM GOTO WRONG
IF NOT EXIST SETUP.EXE GOTO WRONG
IF NOT EXIST EGCBAK\COMPLETE.TAG GOTO MISSING
IF NOT EXIST EGCBAK\SYSTEM.INI GOTO MISSING
IF NOT EXIST EGCBAK\WIN.INI GOTO MISSING
IF NOT EXIST EGCBAK\WIN.COM GOTO MISSING
COPY /B /Y EGCBAK\SYSTEM.INI SYSTEM.INI >NUL
%EGCCMP% EGCBAK\SYSTEM.INI SYSTEM.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /Y EGCBAK\WIN.INI WIN.INI >NUL
%EGCCMP% EGCBAK\WIN.INI WIN.INI >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /B /Y EGCBAK\WIN.COM WIN.COM >NUL
%EGCCMP% EGCBAK\WIN.COM WIN.COM >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO Original Windows configuration restored. Backup retained in EGCBAK.
GOTO END
:WRONG
ECHO Exit Windows and change to its installation directory first.
ECHO Example: CD \WINDOWS
GOTO END
:MISSING
ECHO No complete EGCBAK backup was found. No files have been restored.
GOTO END
:FAILED
ECHO Restore failed. Check the disk before starting Windows.
GOTO END
:NOCMP
ECHO CMPINI.COM is required to verify the copied configuration.
ECHO Default C:\EGCTEST\WIN16\CMPINI.COM; pass a different full path as argument 1.
ECHO No files have been copied.
:END
SET EGCCMP=
